<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that keeps terrazzo serving on login and restarts it on crash.
  Install:
    cp packaging/mac/com.terrazzo.serve.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.terrazzo.serve.plist
  Edit PROGRAM_ARGS below: model path, port, blocks, optional --api-key / --system-file.
  Logs: ~/Library/Logs/terrazzo.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.terrazzo.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>exec "$HOME/.local/bin/terrazzo" serve --model "$HOME/models/qwen3-4b-4bit" --port 8501 --num-gpu-blocks 8192</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/terrazzo.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/terrazzo.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TERRAZZO_MEMORY_CAP_MB</key><string>48000</string>
  </dict>
</dict>
</plist>
